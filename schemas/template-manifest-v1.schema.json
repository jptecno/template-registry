{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jptecno.github.io/template-registry/schemas/template-manifest-v1.schema.json",
  "title": "JP Tecno Template Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "repository",
    "variables",
    "render",
    "toolchain"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^jptecno/[A-Za-z0-9_.-]+$" },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/definitions/variable" }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "requirements", "steps"],
      "properties": {
        "ecosystem": {
          "enum": ["node", "go", "flutter", "rust", "ruby", "python"]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/requirement" }
        },
        "steps": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "install": { "$ref": "#/definitions/step" },
            "formatCheck": { "$ref": "#/definitions/step" },
            "lint": { "$ref": "#/definitions/step" },
            "typecheck": { "$ref": "#/definitions/step" },
            "test": { "$ref": "#/definitions/step" },
            "build": { "$ref": "#/definitions/step" }
          }
        }
      }
    }
  },
  "definitions": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "prompt", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "prompt": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "pattern": { "type": "string", "minLength": 1 },
        "default": { "type": "string" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "minimumVersion"],
      "properties": {
        "tool": {
          "enum": [
            "node",
            "npm",
            "pnpm",
            "yarn",
            "go",
            "flutter",
            "rust",
            "cargo",
            "ruby",
            "bundler",
            "python",
            "pip",
            "poetry"
          ]
        },
        "minimumVersion": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "dependsOn", "recommended"],
      "properties": {
        "command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:\\{|\\}|\\$|`|;|&|\\|)).*$"
          }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "install",
              "formatCheck",
              "lint",
              "typecheck",
              "test",
              "build"
            ]
          }
        },
        "recommended": { "type": "boolean" }
      }
    }
  }
}
