{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jptecno.github.io/template-registry/schemas/template-registry-v2.schema.json",
  "title": "JP Tecno Template Registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "publishedAt", "templates"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "revision": { "type": "integer", "minimum": 1 },
    "publishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/template" }
    }
  },
  "definitions": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "repository", "versions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "repository": {
          "type": "string",
          "pattern": "^jptecno/[A-Za-z0-9_.-]+$"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/version" }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ref", "commit", "status"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "ref": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "status": { "enum": ["active", "deprecated", "revoked"] },
        "statusReason": { "type": "string", "minLength": 1 },
        "replacement": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "active" } } },
          "then": {
            "not": {
              "properties": { "statusReason": {} },
              "required": ["statusReason"]
            }
          },
          "else": {
            "properties": { "statusReason": {} },
            "required": ["statusReason"]
          }
        }
      ]
    }
  }
}
