{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jptecno.github.io/template-registry/schemas/ed25519-detached-envelope-v1.schema.json",
  "title": "Ed25519 Detached Multi-signature Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "payloadSha256", "signatures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "payloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/signature" }
    }
  },
  "definitions": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "signature"],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
