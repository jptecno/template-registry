{
  "schemaVersion": 1,
  "id": "api-nodejs-typescript",
  "name": "API Node.js + TypeScript",
  "description": "Template de API.",
  "repository": "jptecno/template-api-nodejs-typescript",
  "variables": [
    {
      "name": "projectName",
      "prompt": "Nome do projeto",
      "required": true
    }
  ],
  "render": { "include": ["src", "package.json"] },
  "toolchain": {
    "ecosystem": "node",
